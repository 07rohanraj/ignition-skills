{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ignition Query Tag",
  "description": "JSON schema for Ignition Query Tag based on actual project examples",
  "type": "object",
  "required": ["name", "tagType", "valueSource", "query", "dataSource"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Tag name (letters, digits, underscores, spaces, parentheses, single quotes, dashes, colons; <256 chars)"
    },
    "tagType": {
      "type": "string",
      "const": "AtomicTag",
      "description": "Always 'AtomicTag' for query tags"
    },
    "valueSource": {
      "type": "string",
      "const": "db",
      "description": "Always 'db' for query tags"
    },
    "query": {
      "type": "string",
      "description": "SQL query that drives the tag's value"
    },
    "dataSource": {
      "type": "string",
      "description": "Database connection name"
    },
    "queryType": {
      "type": "string",
      "enum": ["AutoDetect", "Select", "Update"],
      "default": "AutoDetect",
      "description": "Query type (Select for reads, Update for writes)"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether tag is evaluated by the Tag Group"
    },
    "dataType": {
      "type": "string",
      "enum": ["Int1", "Int2", "Int4", "Int8", "Float4", "Float8", "Boolean", "String", "DateTime", "DataSet"],
      "description": "Data type of the tag"
    },
    "executionMode": {
      "type": "string",
      "enum": ["EventDriven", "FixedRate", "TagGroupRate"],
      "default": "TagGroupRate",
      "description": "When tag executes"
    },
    "executionRate": {
      "type": "integer",
      "description": "Execution rate in milliseconds (only for FixedRate mode)"
    },
    "readOnly": {
      "type": "boolean",
      "default": true,
      "description": "Whether tag is read-only"
    },
    "tagGroup": {
      "type": "string",
      "default": "Default",
      "description": "Tag Group that will execute the tag"
    },
    "documentation": {
      "type": "string",
      "description": "Freeform documentation text"
    },
    "tooltip": {
      "type": "string",
      "description": "Tooltip text shown on hover in visual components"
    },
    "engLow": {
      "type": ["number", "null"],
      "description": "Lowest expected value of the tag"
    },
    "engHigh": {
      "type": ["number", "null"],
      "description": "Highest expected value of the tag"
    },
    "engUnit": {
      "type": "string",
      "description": "Engineering units"
    },
    "deadband": {
      "type": "number",
      "default": 0,
      "description": "Value threshold to prevent unnecessary updates"
    },
    "deadbandMode": {
      "type": "string",
      "enum": ["Absolute", "Percent", "Off"],
      "default": "Absolute",
      "description": "How deadband is applied"
    },
    "formatString": {
      "type": "string",
      "description": "Numeric format pattern using # and 0 characters"
    },
    "historyEnabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether tag reports to Tag Historian"
    },
    "historyProvider": {
      "type": "string",
      "description": "Target Tag Historian data store"
    },
    "historicalDeadbandStyle": {
      "type": "string",
      "enum": ["Auto", "Analog", "Discrete"],
      "description": "Historical deadband style"
    },
    "historicalDeadbandMode": {
      "type": "string",
      "enum": ["Absolute", "Percent", "Off"],
      "description": "How historical deadband is applied"
    },
    "historicalDeadband": {
      "type": "number",
      "description": "Deadband for historical evaluation"
    },
    "sampleMode": {
      "type": "string",
      "enum": ["OnChange", "Periodic", "TagGroup"],
      "description": "Collection trigger mode"
    },
    "historySampleRate": {
      "type": "number",
      "description": "Collection interval (Periodic mode)"
    },
    "historySampleRateUnits": {
      "type": "string",
      "enum": ["MS", "SEC", "MIN", "HOUR", "DAY", "WEEK", "MONTH", "YEAR"],
      "description": "Time unit for sample rate"
    },
    "historyTimeDeadband": {
      "type": "number",
      "description": "Minimum time between records"
    },
    "historyTimeDeadbandUnits": {
      "type": "string",
      "enum": ["MS", "SEC", "MIN", "HOUR", "DAY", "WEEK", "MONTH", "YEAR"],
      "description": "Time unit for min time between samples"
    },
    "historyMaxAge": {
      "type": "number",
      "description": "Maximum time between samples (0 disables)"
    },
    "historyMaxAgeUnits": {
      "type": "string",
      "enum": ["MS", "SEC", "MIN", "HOUR", "DAY", "WEEK", "MONTH", "YEAR"],
      "description": "Time unit for max time between samples"
    },
    "alarmEvalEnabled": {
      "type": "boolean",
      "default": true,
      "description": "Determines if alarms will be evaluated on this tag"
    },
    "eventScripts": {
      "type": "array",
      "description": "Array of tag event scripts",
      "items": {
        "type": "object",
        "required": ["eventid", "script"],
        "properties": {
          "eventid": {
            "type": "string",
            "enum": ["qualityChanged", "valueChanged", "alarmActive", "alarmCleared", "alarmAcked"],
            "description": "Event type"
          },
          "script": {
            "type": "string",
            "description": "Script content"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "name": "LastAlarm",
      "tagType": "AtomicTag",
      "valueSource": "db",
      "query": "SELECT message FROM alarms ORDER BY timestamp DESC LIMIT 1",
      "dataSource": "MyDatabase",
      "queryType": "Select",
      "enabled": true,
      "dataType": "String",
      "readOnly": true,
      "tagGroup": "Default",
      "documentation": "Last alarm message from database",
      "historyEnabled": false,
      "alarmEvalEnabled": true
    }
  ]
}
